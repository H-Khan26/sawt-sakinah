# Text files are stored and checked out with LF on every platform.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary assets: never converted or diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.onnx binary
*.bin binary
*.zip binary
*.gz binary
*.7z binary
*.exe binary
*.dll binary
*.pyd binary
*.mp3 binary
*.wav binary
*.m4a binary
*.flac binary
*.ogg binary
*.opus binary
