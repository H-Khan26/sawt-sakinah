# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
*.whl

# Virtual environments
.venv/
venv/
env/

# Dot-env / secrets
.env
.env.*

# Local runtime data (projects + cache dirs), anchored to the repo root so that
# source folders with the same names (frontend/src/features/projects) stay tracked.
# The actual paths are under %LOCALAPPDATA% or ~/.local/share by default,
# but if someone points SAWT_PROJECTS_DIR / SAWT_CACHE_DIR at a local folder:
/projects/
/cache/

# Desktop bundle outputs (make bundle / release workflow): PyInstaller work and dist
# folders, the downloaded helper programs and the zips. A bin/ at the repo root would
# shadow PATH for ffmpeg/ffprobe/deno in a source checkout (see runtime.py).
/packaging/build/
/packaging/dist/
/packaging/release/
/bin/

# Test / build caches
.pytest_cache/
node_modules/
*.tsbuildinfo

# Editor / OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
